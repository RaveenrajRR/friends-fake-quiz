# Set true only after your AdSense account/site is ready to serve ads.
VITE_ADS_ENABLED=false

# Your Google AdSense publisher/client ID, e.g. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT_ID=ca-pub-REPLACE_ME

# Create these ad units in AdSense and paste their slot IDs here.
VITE_AD_SLOT_TOP=REPLACE_TOP_SLOT
VITE_AD_SLOT_HOME=REPLACE_HOME_SLOT
VITE_AD_SLOT_CREATE=REPLACE_CREATE_SLOT
VITE_AD_SLOT_QUIZ=REPLACE_QUIZ_SLOT
VITE_AD_SLOT_RESULT=REPLACE_RESULT_SLOT
VITE_AD_SLOT_CREATED=REPLACE_CREATED_SLOT
VITE_AD_SLOT_BOTTOM=REPLACE_BOTTOM_SLOT
